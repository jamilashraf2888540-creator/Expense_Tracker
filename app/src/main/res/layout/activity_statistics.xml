<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/jamil"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="Back"
                android:src="@android:drawable/ic_menu_revert"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Statistics"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvMonth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp"
            android:text="This Month"
            android:textColor="#A5A5B5"
            android:textSize="15sp"/>

        <TextView
            android:id="@+id/tvTotalSpent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="$0.00"
            android:textColor="#F472B6"
            android:textSize="32sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:id="@+id/chartPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:layout_marginTop="25dp"
            android:background="#1A1A2E"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvChartPlaceholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Spending Chart"
                android:textColor="#6C63FF"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Chart will be connected later"
                android:textColor="#777788"
                android:textSize="13sp"/>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Spending by Category"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:id="@+id/categoryStatsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFoodStats"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="#1A1A2E"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:text="Food                         $0.00"
                android:textColor="#FFFFFF"
                android:textSize="15sp"/>

            <TextView
                android:id="@+id/tvTransportStats"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:background="#1A1A2E"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:text="Transport                    $0.00"
                android:textColor="#FFFFFF"
                android:textSize="15sp"/>

            <TextView
                android:id="@+id/tvEducationStats"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:background="#1A1A2E"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:text="Education                    $0.00"
                android:textColor="#FFFFFF"
                android:textSize="15sp"/>

            <TextView
                android:id="@+id/tvBillsStats"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:background="#1A1A2E"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:text="Bills                           $0.00"
                android:textColor="#FFFFFF"
                android:textSize="15sp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>